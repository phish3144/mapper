# Supabase-Projekt "mapper" (Region eu-central-1).
# Beide Werte sind bewusst oeffentlich: der publishable key ist fuer den Browser
# gedacht und wird ausschliesslich durch Row Level Security abgesichert.
# Der service_role-Schluessel gehoert NIEMALS hierher - er lebt nur in den
# Secrets der Edge Function.
VITE_SUPABASE_URL=https://iisiaoexusvoecytznwg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fpGmNfPEo6g1JIpfRbNQ7g_FyHGdfSd

# Routing. Der oeffentliche OSRM-Demoserver kennt ausschliesslich das
# Fahrprofil - Rad und Fuss liefern dort identische Werte. Wer echte Rad-/
# Fussprofile braucht, hinterlegt einen OpenRouteService-Key (kostenlos,
# 2000 Anfragen/Tag) oder eine eigene OSRM-Instanz.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_ORS_API_KEY=
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
